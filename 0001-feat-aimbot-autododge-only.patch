diff --git a/agent/features/aimbot.js b/agent/features/aimbot.js
new file mode 100644
index 0000000..6373532
--- /dev/null
+++ b/agent/features/aimbot.js
@@ -0,0 +1,218 @@
+import
+{
+    fn,
+    off,
+    i32,
+    ptr32,
+    i32At,
+    ptrAt,
+    boolAt
+}
+from "../core/functions.js";
+import
+{
+    logInfo,
+    logWarn
+}
+from "../utils/logger.js";
+import
+{
+    state,
+    setState,
+    setupSafe
+}
+from "../utils/flags.js";
+import
+{
+    leadOf
+}
+from "../helpers/aim_lead.js";
+import
+{
+    canonBrawlerName
+}
+from "../utils/brawlerName.js";
+import
+{
+    sendClientInput
+}
+from "../core/input.js";
+
+var getOwnCharacter = null;
+var getX = null;
+var getY = null;
+var getData = null;
+var getGlobalID = null;
+var getName = null;
+var battlePtr = null;
+var config =
+{
+    range: 1200,
+    lead: true,
+    attackType: 0xa
+};
+
+export function battle()
+{
+    return battlePtr;
+}
+
+export function installBattleCapture()
+{
+    return setupSafe("battle", () =>
+    {
+        getOwnCharacter = ptr32("LogicBattleModeClient_getOwnCharacter");
+        Interceptor.attach(fn("LogicBattleModeClient_getOwnCharacter"),
+        {
+            onEnter(args)
+            {
+                battlePtr = args[0];
+            }
+        });
+        logInfo("battle capture installed");
+    });
+}
+
+export function init(options)
+{
+    return setupSafe("aimbot", () =>
+    {
+        if (!getX)
+        {
+            getX = i32("LogicGameObjectClient_getX");
+            getY = i32("LogicGameObjectClient_getY");
+            getData = ptr32("LogicGameObjectClient_getData");
+            getGlobalID = i32("LogicGameObjectClient_getGlobalID");
+            getName = ptr32("LogicData_getName");
+        }
+        if (options) Object.assign(config, options);
+        logInfo("aimbot ready");
+    });
+}
+
+function objects()
+{
+    const bm = battlePtr;
+    if (!bm) return [];
+    const manager = ptrAt(bm, off("BattleMode_objectManagerPtr"));
+    if (manager.isNull()) return [];
+    const array = ptrAt(manager, off("ObjectManager_objectsArray"));
+    const count = i32At(manager, off("ObjectManager_count"));
+    const stride = off("ObjectManager_ptrStride");
+    if (array.isNull() || count <= 0 || count > 512) return [];
+    const list = [];
+    for (let i = 0; i < count; i++)
+    {
+        const item = array.add(i * stride).readPointer();
+        if (!item.isNull()) list.push(item);
+    }
+    return list;
+}
+
+function teamOf(pointer)
+{
+    return i32At(pointer, off("GameObj_team"));
+}
+
+function alive(pointer)
+{
+    if (boolAt(pointer, off("GameObj_deadFlag"))) return false;
+    return getGlobalID(pointer) !== 0;
+}
+
+function nameOf(pointer)
+{
+    try
+    {
+        const data = getData(pointer);
+        if (data.isNull()) return "";
+        const pointerName = getName(data);
+        if (pointerName.isNull()) return "";
+        return canonBrawlerName(pointerName.readCString());
+    }
+    catch (e)
+    {
+        return "";
+    }
+}
+
+function distSq(ax, ay, bx, by)
+{
+    const dx = ax - bx;
+    const dy = ay - by;
+    return dx * dx + dy * dy;
+}
+
+export function pickTarget()
+{
+    const bm = battlePtr;
+    if (!bm) return null;
+    const self = getOwnCharacter(bm);
+    if (self.isNull()) return null;
+    const ownTeam = teamOf(self);
+    const selfX = getX(self);
+    const selfY = getY(self);
+    let best = null;
+    let bestDist = config.range * config.range;
+    for (const item of objects())
+    {
+        if (item.equals(self)) continue;
+        if (!alive(item)) continue;
+        if (teamOf(item) === ownTeam) continue;
+        const x = getX(item);
+        const y = getY(item);
+        const d = distSq(selfX, selfY, x, y);
+        if (d < bestDist)
+        {
+            bestDist = d;
+            best = item;
+        }
+    }
+    if (!best) return null;
+    return {
+        ptr: best,
+        x: getX(best),
+        y: getY(best),
+        name: nameOf(best)
+    };
+}
+
+export function aimPoint()
+{
+    const bm = battlePtr;
+    if (!bm) return null;
+    const target = pickTarget();
+    if (!target) return null;
+    if (!config.lead) return target;
+    const self = getOwnCharacter(bm);
+    const lead = leadOf(target.name);
+    return {
+        ptr: target.ptr,
+        x: target.x,
+        y: target.y,
+        lead,
+        selfX: getX(self),
+        selfY: getY(self)
+    };
+}
+
+export function fire()
+{
+    if (!state.aimbot) return false;
+    const point = aimPoint();
+    if (!point) return false;
+    const ok = sendClientInput(battlePtr, config.attackType, point.x, point.y);
+    if (!ok) logWarn("aimbot fire failed");
+    return ok;
+}
+
+export function toggle(value)
+{
+    setState("aimbot", value);
+    return state.aimbot;
+}
+
+export function tick()
+{
+    return fire();
+}
diff --git a/agent/features/autododge.js b/agent/features/autododge.js
new file mode 100644
index 0000000..f70a852
--- /dev/null
+++ b/agent/features/autododge.js
@@ -0,0 +1,216 @@
+import
+{
+    off,
+    i32,
+    ptr32,
+    i32At,
+    ptrAt,
+    constant
+}
+from "../core/functions.js";
+import
+{
+    logInfo
+}
+from "../utils/logger.js";
+import
+{
+    state,
+    setState,
+    setupSafe
+}
+from "../utils/flags.js";
+import
+{
+    kindOf,
+    fitOf,
+    FITS
+}
+from "../helpers/dodge_kinds.js";
+import
+{
+    canonBrawlerName
+}
+from "../utils/brawlerName.js";
+import
+{
+    battle
+}
+from "./aimbot.js";
+import
+{
+    sendClientInput
+}
+from "../core/input.js";
+
+var getX = null;
+var getY = null;
+var getData = null;
+var getSpeed = null;
+var getRadius = null;
+var isBeam = null;
+var getTargetX = null;
+var getName = null;
+var projectileData = null;
+var config =
+{
+    range: 900,
+    horizon: 0.45,
+    step: 1.0,
+    moveType: 2
+};
+
+export function init(options)
+{
+    return setupSafe("autododge", () =>
+    {
+        getX = i32("LogicGameObjectClient_getX");
+        getY = i32("LogicGameObjectClient_getY");
+        getData = ptr32("LogicGameObjectClient_getData");
+        getSpeed = i32("LogicProjectileData_getSpeed");
+        getRadius = i32("LogicProjectileData_getRadius");
+        isBeam = i32("LogicProjectileData__isBeam");
+        getTargetX = i32("LogicProjectileClient_getTargetX");
+        getName = ptr32("LogicData_getName");
+        projectileData = constant("VTABLE_PROJECTILE_DATA");
+        if (options) Object.assign(config, options);
+        logInfo("autododge ready");
+    });
+}
+
+function isProjectile(pointer)
+{
+    const data = getData(pointer);
+    if (data.isNull()) return null;
+    const vtable = data.readPointer();
+    if (!vtable.equals(projectileData)) return null;
+    return data;
+}
+
+function list()
+{
+    const bm = battle();
+    if (!bm) return [];
+    const manager = ptrAt(bm, off("BattleMode_objectManagerPtr"));
+    if (manager.isNull()) return [];
+    const array = ptrAt(manager, off("ObjectManager_objectsArray"));
+    const count = i32At(manager, off("ObjectManager_count"));
+    const stride = off("ObjectManager_ptrStride");
+    if (array.isNull() || count <= 0 || count > 512) return [];
+    const out = [];
+    for (let i = 0; i < count; i++)
+    {
+        const item = array.add(i * stride).readPointer();
+        if (item.isNull()) continue;
+        const data = isProjectile(item);
+        if (!data) continue;
+        out.push(item);
+    }
+    return out;
+}
+
+function nameOf(data)
+{
+    try
+    {
+        const pointer = getName(data);
+        if (pointer.isNull()) return "";
+        return canonBrawlerName(pointer.readCString());
+    }
+    catch (e)
+    {
+        return "";
+    }
+}
+
+function threat(item)
+{
+    const data = getData(item);
+    const speed = getSpeed(data);
+    if (speed <= 0) return null;
+    const px = getX(item);
+    const py = getY(item);
+    const tx = getTargetX(item);
+    const ty = i32At(item, off("LogicProjectileClient_targetY"));
+    const dx = tx - px;
+    const dy = ty - py;
+    const len = Math.sqrt(dx * dx + dy * dy);
+    if (!len) return null;
+    return {
+        ptr: item,
+        speed,
+        radius: getRadius(data),
+        beam: isBeam(data) !== 0,
+        x: px,
+        y: py,
+        tx,
+        ty,
+        ux: dx / len,
+        uy: dy / len,
+        eta: len / speed
+    };
+}
+
+export function scan()
+{
+    const bm = battle();
+    if (!bm) return [];
+    const self = bm;
+    const sx = getX(self);
+    const sy = getY(self);
+    const found = [];
+    for (const item of list())
+    {
+        const info = threat(item);
+        if (!info) continue;
+        info.dist = Math.sqrt((info.tx - sx) * (info.tx - sx) + (info.ty - sy) * (info.ty - sy));
+        info.name = nameOf(getData(item));
+        info.eta = info.dist / info.speed;
+        if (info.dist > config.range) continue;
+        if (info.eta > config.horizon) continue;
+        found.push(info);
+    }
+    found.sort((a, b) => a.eta - b.eta);
+    return found;
+}
+
+export function dodgeVector()
+{
+    const threats = scan();
+    if (!threats.length) return null;
+    const first = threats[0];
+    const kind = kindOf(first.name);
+    const fit = FITS[fitOf(first.name)] || FITS.broad;
+    const side = (first.ux * 0 - first.uy) >= 0 ? 1 : -1;
+    const push = (first.radius + fit.pad) * fit.grow * config.step;
+    return {
+        threat: first,
+        kind,
+        dx: Math.round(-first.uy * side * push),
+        dy: Math.round(first.ux * side * push)
+    };
+}
+
+export function step()
+{
+    if (!state.autododge) return false;
+    const bm = battle();
+    if (!bm) return false;
+    const vector = dodgeVector();
+    if (!vector) return false;
+    const x = getX(bm) + vector.dx;
+    const y = getY(bm) + vector.dy;
+    sendClientInput(bm, config.moveType, x, y);
+    return true;
+}
+
+export function toggle(value)
+{
+    setState("autododge", value);
+    return state.autododge;
+}
+
+export function tick()
+{
+    return step();
+}
